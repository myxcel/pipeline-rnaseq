configfile: "config/config.yaml"

SAMPLES = config["samples"]
READS = ["1", "2"]

rule all:
    input:
        "results/qc/raw/multiqc_report.html",
        "results/qc/trimmed/multiqc_report.html",
        expand("data/trimmed/{sample}_{read}.trimmed.fastq.gz", sample=SAMPLES, read=READS)

