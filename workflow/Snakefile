# Snakefile principal
configfile: "config/config.yaml"

SAMPLES = config["samples"]

# ── Règle finale : tous les résultats désirés ──────
rule all:
    input:
        "results/qc/multiqc_report.html",
        "results/deseq2/PCA_plot.png",
        "results/deseq2/Volcano_plot.png",
        "results/deseq2/Heatmap_top50.png",
        "results/deseq2/GO_dotplot_UP.png"

# ── FastQC ─────────────────────────────────────────
rule fastqc:
    input:  "data/raw/{sample}_{read}.fastq.gz"
    output: "results/qc/fastqc/{sample}_{read}_fastqc.html"
    conda:  "envs/qc.yaml"
    threads: 2
    shell:  "fastqc {input} -o results/qc/fastqc/ -t {threads}"

# ── MultiQC ────────────────────────────────────────
rule multiqc:
    input:  expand("results/qc/fastqc/{sample}_{read}_fastqc.html",
                   sample=SAMPLES, read=["1","2"])
    output: "results/qc/multiqc_report.html"
    conda:  "envs/qc.yaml"
    shell:  "multiqc results/qc/fastqc/ -o results/qc/ -n multiqc_report.html"

# ── fastp (trimming) ───────────────────────────────
rule fastp:
    input:
        r1 = "data/raw/{sample}_1.fastq.gz",
        r2 = "data/raw/{sample}_2.fastq.gz"
    output:
        r1 = "results/trimmed/{sample}_1_trimmed.fastq.gz",
        r2 = "results/trimmed/{sample}_2_trimmed.fastq.gz"
    conda:  "envs/qc.yaml"
    threads: 4
    shell:
        "fastp --in1 {input.r1} --in2 {input.r2} "
        "--out1 {output.r1} --out2 {output.r2} "
        "--thread {threads} --detect_adapter_for_pe "
        "--qualified_quality_phred 20 --length_required 36"

# ── STAR (alignement) ──────────────────────────────
rule star_align:
    input:
        r1    = "results/trimmed/{sample}_1_trimmed.fastq.gz",
        r2    = "results/trimmed/{sample}_2_trimmed.fastq.gz",
        index = config["star_index"]
    output:
        bam   = "results/aligned/{sample}_Aligned.sortedByCoord.out.bam",
        bai   = "results/aligned/{sample}_Aligned.sortedByCoord.out.bam.bai"
    conda:  "envs/align.yaml"
    threads: 8
    shell:
        "STAR --runThreadN {threads} "
        "--genomeDir {input.index} "
        "--readFilesIn {input.r1} {input.r2} "
        "--readFilesCommand zcat "
        "--outSAMtype BAM SortedByCoordinate "
        "--outFileNamePrefix results/aligned/{wildcards.sample}_ && "
        "samtools index {output.bam}"

# ── featureCounts ──────────────────────────────────
rule featurecounts:
    input:
        bams = expand("results/aligned/{sample}_Aligned.sortedByCoord.out.bam",
                      sample=SAMPLES),
        gtf  = config["gtf_file"]
    output: "results/counts/counts_matrix.txt"
    conda:  "envs/align.yaml"
    threads: 8
    shell:
        "featureCounts -T {threads} -p --countReadPairs -s 2 "
        "-a {input.gtf} -o {output} {input.bams}"

# ── DESeq2 + GO (R) ────────────────────────────────
rule deseq2:
    input:  "results/counts/counts_matrix.txt"
    output:
        pca     = "results/deseq2/PCA_plot.png",
        volcano = "results/deseq2/Volcano_plot.png",
        heatmap = "results/deseq2/Heatmap_top50.png"
    conda:  "envs/deseq2.yaml"
    script: "scripts/deseq2_analysis.R"

rule go_enrichment:
    input:  "results/deseq2/DE_results.csv"
    output: "results/deseq2/GO_dotplot_UP.png"
    conda:  "envs/deseq2.yaml"
    script: "scripts/go_enrichment.R"
